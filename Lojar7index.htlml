<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>R7 Store — Painéis e Produtos</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        :root {
            --primaria: #6366f1; --secundaria: #8b5cf6; --fundo: #0f1729;
            --card: #1e293b; --texto: #e2e8f0; --texto-claro: #94a3b8;
            --sucesso: #10b981; --aviso: #f59e0b; --perigo: #ef4444; --whatsapp: #25d366;
            --azul-claro: #3b82f6;
        }
        body { background: linear-gradient(135deg, var(--fundo), #1a2744); min-height: 100vh; color: var(--texto); padding-bottom: 40px; }

        /* Botão WhatsApp Fixo */
        .btn-whatsapp-fixo {
            position: fixed; bottom: 20px; right: 20px; background: var(--whatsapp);
            color: white; width: 60px; height: 60px; border-radius: 50%; display: flex;
            align-items: center; justify-content: center; font-size: 28px; z-index: 999;
            box-shadow: 0 4px 12px rgba(37,211,106,0.4); text-decoration: none;
        }
        .btn-whatsapp-fixo:hover { transform: scale(1.1); }

        /* Banner Topo */
        .banner-topo {
            background: linear-gradient(90deg, var(--perigo), var(--aviso)); color: white;
            text-align: center; padding: 10px; font-weight: 600; position: fixed;
            top: 0; left: 0; right: 0; z-index: 101; font-size: 14px;
        }

        /* Cabeçalho */
        header {
            background: rgba(15,23,41,0.95); position: fixed; top: 42px; left: 0; right: 0;
            z-index: 100; padding: 12px 20px; border-bottom: 1px solid rgba(99,102,241,0.2);
        }
        .nav { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        .logo { font-size: 20px; font-weight: bold; background: linear-gradient(90deg, var(--primaria), var(--secundaria)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; cursor: pointer; }
        .menu { display: flex; gap: 16px; list-style: none; flex-wrap: wrap; margin-top: 8px; }
        .menu a { color: var(--texto); text-decoration: none; font-size: 14px; cursor: pointer; }
        .menu a:hover { color: var(--primaria); }

        /* Seções */
        section { display: none; padding: 110px 20px 30px; max-width: 1200px; margin: 0 auto; animation: fadeIn 0.3s ease; }
        section.ativa { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        h2 { text-align: center; font-size: 24px; margin-bottom: 24px; }
        .subtitulo { text-align: center; color: var(--texto-claro); margin-bottom: 24px; }

        /* Selos e Contadores */
        .selos-loja { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .selo-mini { background: rgba(16,185,129,0.1); border: 1px solid var(--sucesso); padding: 4px 10px; border-radius: 20px; font-size: 12px; color: var(--sucesso); }
        .contador-clientes { background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.2); border-radius: 8px; padding: 10px; text-align: center; margin-bottom: 16px; font-size: 14px; }
        .visitantes { text-align: center; font-size: 13px; color: var(--azul-claro); margin-bottom: 12px; }
        .ultimas-vendas { background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.15); border-radius: 8px; padding: 10px; text-align: center; margin-bottom: 16px; font-size: 14px; color: var(--texto-claro); }

        /* Contador */
        .contador-box { background: rgba(139,92,246,0.15); border: 1px solid var(--secundaria); border-radius: 10px; padding: 16px; text-align: center; margin-bottom: 16px; }
        .contador-box p { margin-bottom: 8px; font-weight: 600; font-size: 14px; }
        .contador-tempo { font-size: 28px; font-weight: bold; color: var(--aviso); }

        /* Estoque */
        .estoque-box { background: rgba(16,185,129,0.1); border: 1px solid var(--sucesso); border-radius: 8px; padding: 10px 16px; text-align: center; margin-bottom: 16px; }
        .progresso-estoque { width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; margin-top: 8px; overflow: hidden; }
        .barra-estoque { height: 100%; background: linear-gradient(90deg, var(--perigo), var(--aviso)); width: 40%; border-radius: 4px; }

        /* Caixa Bônus e Convite */
        .bonus-box { background: rgba(16,185,129,0.1); border: 1px solid var(--sucesso); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
        .bonus-box h3 { color: var(--sucesso); margin-bottom: 10px; font-size: 16px; }
        .bonus-box ul { list-style: none; font-size: 14px; color: var(--texto-claro); }
        .bonus-box li { margin-bottom: 6px; }
        .convite-amigo { background: rgba(139,92,246,0.1); border: 1px solid var(--secundaria); border-radius: 10px; padding: 16px; text-align: center; margin-bottom: 16px; }
        .convite-amigo h4 { margin-bottom: 6px; font-size: 15px; }
        .convite-amigo p { font-size: 13px; color: var(--texto-claro); margin-bottom: 10px; }
        .compartilhar-btn { background: var(--secundaria); color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; }

        /* Botão WhatsApp Principal */
        .btn-whatsapp { display: inline-flex; align-items: center; gap: 8px; background: var(--whatsapp); color: white !important; padding: 12px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; font-size: 16px; }
        .btn-whatsapp:hover { transform: translateY(-2px); }
        .centralizar { text-align: center; margin-top: 10px; }

        /* Categorias */
        .categorias { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
        .categoria-btn { background: transparent; border: 1px solid rgba(99,102,241,0.3); color: var(--texto); padding: 6px 14px; border-radius: 20px; cursor: pointer; font-size: 13px; }
        .categoria-btn.ativa, .categoria-btn:hover { background: var(--primaria); border-color: var(--primaria); }

        /* Níveis */
        .niveis { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 40px; }
        .card-nivel { background: var(--card); border-radius: 12px; padding: 20px; text-align: center; border: 2px solid transparent; }
        .card-nivel.destaque { border-color: var(--secundaria); transform: scale(1.02); }
        .card-nivel h3 { font-size: 16px; margin-bottom: 8px; }
        .card-nivel .preco { font-size: 22px; font-weight: bold; color: var(--sucesso); margin-bottom: 12px; }
        .card-nivel ul { list-style: none; font-size: 13px; color: var(--texto-claro); margin-bottom: 16px; }
        .card-nivel li { margin-bottom: 4px; }

        /* Grade Produtos */
        .grade-produtos { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .card-produto { background: var(--card); border-radius: 12px; overflow: hidden; border: 1px solid rgba(99,102,241,0.15); position: relative; }
        .produto-tag { position: absolute; top: 10px; right: 10px; background: var(--perigo); color: white; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 12px; z-index: 2; }
        .produto-tag.lancamento { background: var(--azul-claro); }
        .produto-tag.exclusivo { background: linear-gradient(90deg, var(--primaria), var(--secundaria)); }
        .produto-imagem { width: 100%; height: 140px; background: linear-gradient(135deg, var(--primaria), var(--secundaria)); display: flex; align-items: center; justify-content: center; font-size: 36px; }
        .produto-conteudo { padding: 16px; }
        .produto-nome { font-size: 16px; margin-bottom: 6px; }
        .produto-desc { color: var(--texto-claro); font-size: 13px; margin-bottom: 10px; line-height: 1.5; }
        .produto-preco { font-size: 20px; font-weight: bold; color: var(--sucesso); margin-bottom: 12px; }
        .produto-preco span { font-size: 13px; color: var(--texto-claro); text-decoration: line-through; margin-left: 6px; }
        .btn-comprar { display: block; background: linear-gradient(90deg, var(--primaria), var(--secundaria)); color: white; text-align: center; padding: 10px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; }

        /* Galeria */
        .grade-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .item-galeria { background: var(--card); border-radius: 12px; padding: 16px; text-align: center; border: 1px solid rgba(99,102,241,0.1); }
        .item-galeria iframe { width: 100%; height: 180px; border-radius: 8px; border: none; margin-bottom: 10px; }
        .item-galeria span { font-size: 40px; display: block; margin-bottom: 8px; }
        .item-galeria p { font-size: 14px; color: var(--texto-claro); }

        /* Novidades */
        .novidade-card { background: var(--card); border-radius: 10px; padding: 16px; margin-bottom: 12px; border-left: 3px solid var(--azul-claro); }
        .novidade-data { font-size: 13px; color: var(--azul-claro); margin-bottom: 6px; }
        .novidade-badge { background: var(--azul-claro); color: white; font-size: 10px; padding: 2px 6px; border-radius: 8px; margin-left: 6px; }

        /* Changelog */
        .changelog-item { background: var(--card); border-radius: 10px; padding: 16px; margin-bottom: 12px; border-left: 3px solid var(--primaria); }
        .changelog-data { font-size: 13px; color: var(--aviso); margin-bottom: 6px; }
        .changelog-item h4 { margin-bottom: 8px; font-size: 15px; }
        .changelog-item ul { list-style: none; font-size: 14px; color: var(--texto-claro); }
        .changelog-item li { margin-bottom: 4px; }

        /* Depoimentos */
        .grade-depoimentos { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
        .card-depoimento { background: var(--card); border-radius: 10px; padding: 16px; border: 1px solid rgba(99,102,241,0.1); }
        .estrelas { color: #f59e0b; font-size: 14px; margin-bottom: 8px; }
        .depoimento-texto { color: var(--texto); font-size: 14px; line-height: 1.6; margin-bottom: 8px; }
        .depoimento-nome { color: var(--texto-claro); font-size: 13px; font-style: italic; }

        /* FAQ */
        .faq-item { background: var(--card); border-radius: 10px; margin-bottom: 10px; border: 1px solid rgba(99,102,241,0.1); }
        .faq-pergunta { padding: 14px 16px; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; font-size: 14px; }
        .faq-resposta { padding: 0 16px 14px; color: var(--texto-claro); font-size: 14px; line-height: 1.6; }

        /* Sobre e Contato */
        .texto-box { background: var(--card); border-radius: 10px; padding: 24px; line-height: 1.8; color: var(--texto-claro); font-size: 14px; }
        .redes-sociais { display: flex; justify-content: center; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
        .btn-rede { background: var(--card); color: var(--texto); padding: 8px 14px; border-radius: 8px; text-decoration: none; border: 1px solid rgba(99,102,241,0.15); font-size: 14px; }
        .btn-rede:hover { border-color: var(--primaria); }

        /* Rodapé */
        footer { text-align: center; padding: 30px 20px; color: var(--texto-claro); font-size: 13px; margin-top: 20px; }
    </style>
</head>
<body>

<a href="https://wa.me/qr/6NZ2Z7QQWKAQL1" class="btn-whatsapp-fixo" target="_blank">💬</a>

<div class="banner-topo">🔥 PROMOÇÃO — Até 45% OFF! Compre hoje e ganhe BÔNUS GRÁTIS! 🔥</div>

<header>
    <div class="nav">
        <div class="logo" onclick="mostrar('inicio')">🏪 R7 Store</div>
        <ul class="menu">
            <li><a onclick="mostrar('inicio')">Início</a></li>
            <li><a onclick="mostrar('produtos')">Produtos</a></li>
            <li><a onclick="mostrar('galeria')">Provas</a></li>
            <li><a onclick="mostrar('novidades')">Novidades</a></li>
            <li><a onclick="mostrar('depoimentos')">Depoimentos</a></li>
            <li><a onclick="mostrar('changelog')">Atualizações</a></li>
            <li><a onclick="mostrar('faq')">Dúvidas</a></li>
            <li><a onclick="mostrar('sobre')">Sobre</a></li>
            <li><a onclick="mostrar('contato')">Contato</a></li>
        </ul>
    </div>
</header>

<!-- ========== INÍCIO ========== -->
<section id="inicio" class="ativa">
    <div style="text-align: center; padding-top: 20px;">
        <h1 style="font-size: 32px; margin-bottom: 12px;">Bem-vindo à <span style="color: var(--primaria);">R7 Store</span> 🛒</h1>
        <p style="color: var(--texto-claro); max-width: 600px; margin: 0 auto 24px; font-size: 15px;">Painéis, configurações e produtos exclusivos com qualidade e suporte direto comigo. Turbine seu jogo hoje mesmo!</p>

        <div class="selos-loja">
            <span class="selo-mini">🛡️ 100% Seguro</span>
            <span class="selo-mini">⚡ Entrega Rápida</span>
