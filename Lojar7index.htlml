<script>
// Navegação entre seções
function mostrar(id) {
    document.querySelectorAll('section').forEach(s => s.classList.remove('ativa'));
    document.getElementById(id).classList.add('ativa');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Filtro de produtos
function filtrar(categoria) {
    document.querySelectorAll('.categoria-btn').forEach(btn => btn.classList.remove('ativa'));
    event.target.classList.add('ativa');
    
    document.querySelectorAll('.card-produto').forEach(card => {
        if (categoria === 'todos' || card.dataset.categoria === categoria) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });
}

// Contador regressivo
function atualizarContador() {
    const agora = new Date();
    const fim = new Date();
    fim.setHours(23, 59, 59);
    let diff = fim - agora;
    if (diff < 0) diff = 0;
    
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    
    const el = document.getElementById('contador-tempo');
    if (el) el.textContent = 
        (h+'').padStart(2,'0') + ':' + 
        (m+'').padStart(2,'0') + ':' + 
        (s+'').padStart(2,'0');
}
setInterval(atualizarContador, 1000);
atualizarContador();

// Últimas vendas aleatórias
const vendas = [
    "João, de Serra — comprou há 5 minutos",
    "Mariana, de Vitória — comprou há 12 minutos",
    "Lucas, de Cariacica — comprou há 18 minutos",
    "Amanda, de Vila Velha — comprou há 25 minutos",
    "Pedro, de Linhares — comprou há 33 minutos",
    "Rafael, de Guarapari — comprou há 47 minutos"
];
setInterval(() => {
    const el = document.getElementById('venda-aleatoria');
    if (el) el.textContent = vendas[Math.floor(Math.random() * vendas.length)];
}, 15000);
</script>

