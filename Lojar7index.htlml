</section>

<!-- ========== GALERIA ========== -->
<section id="galeria">
    <h2>📸 Provas, Vídeos & Resultados</h2>
    <div class="grade-galeria">
        <div class="item-galeria">
            <h4>🎮 Painel em funcionamento</h4>
            <iframe src=https://vt.tiktok.com/ZSgD4QFa9/</p>
        </div>
        <div class="item-galeria">
            <h4>🎯 Tiros na Cabeça</h4>
